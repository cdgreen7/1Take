{
  "expo": {
    "scheme": "vidjournal",
    "experiments": {
      "typedRoutes": true
    },
    "name": "vidjournal",
    "slug": "vidjournal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.vidjournal"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow vidjournal to access your camera so you can record journal entries.",
          "microphonePermission": "Allow vidjournal to access your microphone so your journal videos include audio.",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}
